# Fire Atlas API. Секретные значения в репозиторий не коммитятся (NFR-05).
FA_ENV=dev                                   # dev | test | production
FA_DB_PATH=var/fire_atlas.sqlite3
FA_ASSETS_DIR=var/assets
FA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FA_COOKIE_SECURE=false                       # в production всегда true
FA_CURSOR_SECRET=                            # обязателен в production: 32+ случайных байта
FA_VALIDATE_RESPONSES=true                   # проверка собственных ответов по openapi.yaml (выключается в production)
FA_IMPORT_PROFILE=dev                        # dev - недобор P0 как предупреждения; p0 - блокирует
FA_FEATURE_ANALYSIS=false                    # включаются только реально работающие функции (BE-04)
FA_FEATURE_REPORTS=false
FA_FEATURE_SEMANTIC_SEARCH=false
FA_FEATURE_VIDEO_PREVIEW=false
FA_WORKSPACE_DAYS=7
FA_REPORT_HOURS=24
FA_SEARCH_PER_MINUTE=60                      # BE-05: поисковых запросов в минуту на клиентский адрес (0 - без лимита)
FA_SEARCH_DEADLINE_S=10                      # дедлайн вызова retrieve из POST /search
FA_SCENARIO_PRESETS=                         # D-007: свой JSON пресетов; пусто - встроенный файл
FA_FORWARDED_ALLOW_IPS=127.0.0.1             # от кого принимать X-Forwarded-For; в compose задан "*" (за nginx)
FA_RAW_DIR=                                  # D-038: исходные файлы NASA (data/raw AI 1) для stage-assets в scripts/start.sh
